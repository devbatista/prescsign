<%# Renders one doctor-specialty row (name via datalist + RQE). Expects `sf`. %>
<div class="rounded-xl border border-ps-border bg-[#f9fbff] p-4">
  <div class="grid gap-3 sm:grid-cols-2">
    <div>
      <%= sf.label :specialty_name, "Especialidade", class: "block text-sm font-semibold text-ps-slate-700" %>
      <%= sf.text_field :specialty_name, list: "specialties-list", value: sf.object.specialty&.name,
            placeholder: "Ex.: Cardiologia",
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>
    <div>
      <%= sf.label :rqe_number, "RQE (opcional)", class: "block text-sm font-semibold text-ps-slate-700" %>
      <%= sf.text_field :rqe_number,
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>
  </div>

  <% if sf.object.persisted? %>
    <label class="mt-3 inline-flex items-center gap-2 text-sm text-ps-slate-600">
      <%= sf.check_box :_destroy %> Remover esta especialidade
    </label>
  <% end %>
</div>
