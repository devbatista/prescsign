<% content_for :title, "Painel · PrescSign" %>

<!-- Welcome card -->
<section class="rounded-2xl border border-ps-border bg-gradient-to-br from-white to-[#f6faff] p-6 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-[#4a6b93]"><%= persona_label(@persona) %></p>
      <h1 class="mt-1 text-2xl font-bold tracking-tight text-ps-slate-900 sm:text-3xl">
        Bem-vindo, <%= user_display_name(current_user) %>!
      </h1>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if access_context.can?(:patients) %>
        <%= link_to "Pacientes", patients_path, class: "rounded-lg bg-ps-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-ps-blue-700" %>
      <% end %>
      <%= link_to "Meu Perfil", profile_path, class: "rounded-lg bg-ps-green-500 px-4 py-2 text-sm font-semibold text-white hover:brightness-105" %>
    </div>
  </div>
</section>

<% if @persona == :doctor %>
  <!-- Doctor indicators -->
  <section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-ps-slate-900">Minha Atuação</h2>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% [
           ["Consultas hoje", @doctor_consultations_today],
           ["Próximas consultas", @doctor_upcoming_consultations_count],
           ["Documentos no mês", @doctor_documents_month],
           ["Meus pacientes ativos", @patients_active]
         ].each do |label, value| %>
        <div class="rounded-xl border border-ps-border bg-[#f9fbff] p-4">
          <div class="text-sm text-ps-slate-500"><%= label %></div>
          <div class="mt-1 text-xl font-bold text-ps-slate-900"><%= value %></div>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Doctor agenda -->
  <section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-lg font-bold text-ps-slate-900">Minha Agenda</h2>
      <%= link_to "Ver agenda", agenda_path, class: "rounded-lg bg-ps-slate-900 px-4 py-2 text-sm font-semibold text-white hover:opacity-90" %>
    </div>

    <% if @doctor_upcoming_consultations.any? %>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-ps-border text-ps-slate-500">
              <th class="py-2 font-medium">Data</th>
              <th class="py-2 font-medium">Paciente</th>
              <th class="py-2 font-medium">Motivo</th>
              <th class="py-2 font-medium">Status</th>
              <th class="py-2 font-medium">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @doctor_upcoming_consultations.each do |consultation| %>
              <tr class="border-b border-ps-border/60">
                <td class="py-3 font-medium text-ps-slate-900"><%= consultation.scheduled_at&.strftime("%d/%m/%Y %H:%M") %></td>
                <td class="py-3 text-ps-slate-700"><%= consultation.patient.full_name %></td>
                <td class="py-3 text-ps-slate-700"><%= consultation.chief_complaint.presence || "—" %></td>
                <td class="py-3"><%= consultation_status_pill(consultation.status) %></td>
                <td class="py-3">
                  <%= link_to "Ver", consultation_path(consultation), class: "rounded-lg border border-ps-border px-3 py-1.5 text-xs font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-4 rounded-lg border border-dashed border-ps-border p-4 text-sm text-ps-slate-500">
        Nenhuma consulta futura atribuída a você.
      </p>
    <% end %>
  </section>

  <!-- Doctor documents -->
  <section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-lg font-bold text-ps-slate-900">Meus Documentos Recentes</h2>
      <div class="flex flex-wrap gap-2">
        <%= link_to "Emitir receita", new_prescription_path, class: "rounded-lg border border-ps-border px-4 py-2 text-sm font-semibold text-ps-blue-700 hover:bg-[#eef4ff]" %>
        <%= link_to "Emitir atestado", new_medical_certificate_path, class: "rounded-lg border border-ps-border px-4 py-2 text-sm font-semibold text-ps-blue-700 hover:bg-[#eef4ff]" %>
      </div>
    </div>

    <% if @doctor_recent_documents.any? %>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-ps-border text-ps-slate-500">
              <th class="py-2 font-medium">Tipo</th>
              <th class="py-2 font-medium">Paciente</th>
              <th class="py-2 font-medium">Status</th>
              <th class="py-2 font-medium">Emissão</th>
              <th class="py-2 font-medium">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @doctor_recent_documents.each do |document| %>
              <tr class="border-b border-ps-border/60">
                <td class="py-3 font-medium text-ps-slate-900"><%= document_kind_label(document.kind) %></td>
                <td class="py-3 text-ps-slate-700"><%= document.patient.full_name %></td>
                <td class="py-3"><%= document_status_pill(document.status) %></td>
                <td class="py-3 text-ps-slate-700"><%= document.issued_on&.strftime("%d/%m/%Y") %></td>
                <td class="py-3">
                  <%= link_to "Ver documento", document_path(document), class: "rounded-lg border border-ps-border px-3 py-1.5 text-xs font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-4 rounded-lg border border-dashed border-ps-border p-4 text-sm text-ps-slate-500">
        Nenhum documento emitido por você ainda.
      </p>
    <% end %>
  </section>

  <!-- Doctor patients -->
  <section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-lg font-bold text-ps-slate-900">Meus Pacientes</h2>
    </div>

    <% if @recent_patients.any? %>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-ps-border text-ps-slate-500">
              <th class="py-2 font-medium">Nome</th>
              <th class="py-2 font-medium">CPF</th>
              <th class="py-2 font-medium">Status</th>
              <th class="py-2 font-medium">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_patients.each do |patient| %>
              <tr class="border-b border-ps-border/60">
                <td class="py-3 font-medium text-ps-slate-900"><%= patient.full_name %></td>
                <td class="py-3 text-ps-slate-700"><%= number_to_cpf(patient.cpf) %></td>
                <td class="py-3">
                  <% if patient.active %>
                    <span class="rounded-full bg-ps-success-bg px-2 py-0.5 text-xs font-medium text-ps-success-fg">Ativo</span>
                  <% else %>
                    <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-ps-slate-500">Inativo</span>
                  <% end %>
                </td>
                <td class="py-3">
                  <%= link_to "Ver histórico", patient_path(patient), class: "rounded-lg border border-ps-border px-3 py-1.5 text-xs font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-4 rounded-lg border border-dashed border-ps-border p-4 text-sm text-ps-slate-500">
        Nenhum paciente vinculado a você ainda.
      </p>
    <% end %>
  </section>
<% else %>
  <!-- Real indicators -->
  <section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-ps-slate-900">Indicadores Reais</h2>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <% [
           ["Pacientes (total)", @patients_total],
           ["Pacientes ativos", @patients_active],
           ["Organização ativa", current_organization&.name || "—"],
           ["Perfis do usuário", current_user.user_roles.active.pluck(:role).join(", ").presence || "—"]
         ].each do |label, value| %>
        <div class="rounded-xl border border-ps-border bg-[#f9fbff] p-4">
          <div class="text-sm text-ps-slate-500"><%= label %></div>
          <div class="mt-1 text-xl font-bold text-ps-slate-900"><%= value %></div>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Recent patients -->
  <section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-ps-slate-900">Pacientes Recentes</h2>
      <%= link_to "Recarregar", "#", class: "rounded-lg bg-ps-slate-900 px-4 py-2 text-sm font-semibold text-white hover:opacity-90" %>
    </div>

    <% if @recent_patients.any? %>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-ps-border text-ps-slate-500">
              <th class="py-2 font-medium">Nome</th>
              <th class="py-2 font-medium">CPF</th>
              <th class="py-2 font-medium">Status</th>
              <th class="py-2 font-medium">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_patients.each do |patient| %>
              <tr class="border-b border-ps-border/60">
                <td class="py-3 font-medium text-ps-slate-900"><%= patient.full_name %></td>
                <td class="py-3 text-ps-slate-700"><%= number_to_cpf(patient.cpf) %></td>
                <td class="py-3">
                  <% if patient.active %>
                    <span class="rounded-full bg-ps-success-bg px-2 py-0.5 text-xs font-medium text-ps-success-fg">Ativo</span>
                  <% else %>
                    <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-ps-slate-500">Inativo</span>
                  <% end %>
                </td>
                <td class="py-3">
                  <%= link_to "Ver histórico", patient_path(patient), class: "rounded-lg border border-ps-border px-3 py-1.5 text-xs font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-4 rounded-lg border border-dashed border-ps-border p-4 text-sm text-ps-slate-500">
        Nenhum paciente cadastrado nesta organização ainda.
      </p>
    <% end %>
  </section>

  <!-- Recent doctors -->
  <section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-ps-slate-900">Médicos Recentes</h2>
      <% if access_context.can?(:doctors) %>
        <%= link_to "Cadastrar Médico", new_doctor_path, class: "rounded-lg border border-ps-border px-4 py-2 text-sm font-semibold text-ps-blue-700 hover:bg-[#eef4ff]" %>
      <% end %>
    </div>

    <% if @recent_doctors.any? %>
      <ul class="mt-4 divide-y divide-ps-border/60">
        <% @recent_doctors.each do |doctor| %>
          <li class="flex items-center justify-between py-3 text-sm">
            <span class="font-medium text-ps-slate-900"><%= doctor.full_name %></span>
            <span class="text-ps-slate-500"><%= [doctor.license_number, doctor.license_state].compact.join(" / ").presence || "—" %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 rounded-lg border border-dashed border-ps-border p-4 text-sm text-ps-slate-500">
        Nenhum médico cadastrado nesta organização ainda.
      </p>
    <% end %>
  </section>
<% end %>
