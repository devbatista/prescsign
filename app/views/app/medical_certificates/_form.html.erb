<%= form_with model: medical_certificate,
      url: (medical_certificate.persisted? ? medical_certificate_path(medical_certificate) : medical_certificates_path),
      method: (medical_certificate.persisted? ? :patch : :post), class: "space-y-5" do |f| %>
  <% if medical_certificate.errors.any? %>
    <div class="rounded-lg border border-ps-error-border bg-ps-error-bg px-3 py-2 text-sm text-ps-error-fg">
      <%= medical_certificate.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <%= f.label :patient_id, "Paciente", class: "block text-sm font-semibold text-ps-slate-700" %>
      <% if medical_certificate.persisted? %>
        <p class="mt-2 rounded-lg border border-ps-border bg-[#f9fbff] px-3 py-2 text-sm text-ps-slate-900"><%= medical_certificate.patient.full_name %></p>
      <% else %>
        <%= f.collection_select :patient_id, patients, :id, :full_name,
              { include_blank: "Selecione um paciente" },
              { required: true, class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" } %>
      <% end %>
    </div>

    <div>
      <%= f.label :issued_on, "Data de emissão", class: "block text-sm font-semibold text-ps-slate-700" %>
      <%= f.date_field :issued_on, required: true,
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>

    <div>
      <%= f.label :icd_code, "CID (opcional)", class: "block text-sm font-semibold text-ps-slate-700" %>
      <%= f.text_field :icd_code, placeholder: "Ex.: J11",
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>

    <div>
      <%= f.label :rest_start_on, "Início do afastamento", class: "block text-sm font-semibold text-ps-slate-700" %>
      <%= f.date_field :rest_start_on, required: true,
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>

    <div>
      <%= f.label :rest_end_on, "Fim do afastamento", class: "block text-sm font-semibold text-ps-slate-700" %>
      <%= f.date_field :rest_end_on, required: true,
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>

    <div class="sm:col-span-2">
      <%= f.label :content, "Conteúdo clínico", class: "block text-sm font-semibold text-ps-slate-700" %>
      <%= f.text_area :content, rows: 6, required: true, placeholder: "Justificativa e orientações do afastamento",
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>
  </div>

  <div class="flex gap-2">
    <%= f.submit (medical_certificate.persisted? ? "Salvar" : "Emitir atestado"),
          class: "ps-btn-primary cursor-pointer rounded-lg px-4 py-2.5 text-sm font-semibold" %>
    <%= link_to "Cancelar", (medical_certificate.persisted? ? document_path(medical_certificate.document) : app_root_path),
          class: "rounded-lg border border-ps-border px-4 py-2.5 text-sm font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
  </div>
<% end %>
