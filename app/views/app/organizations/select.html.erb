<% content_for :title, "Escolher organização · PrescSign" %>
<% content_for :hide_topbar, true %>
<% content_for :main_class, "ps-auth-bg flex min-h-screen items-center justify-center px-4 py-10 sm:px-6" %>

<section class="w-full max-w-md">
  <div class="mb-10 text-center">
    <img src="/prescsign-logo.svg" alt="PrescSign" class="mx-auto h-11 w-auto" />
    <h1 class="mt-8 text-2xl font-bold tracking-tight text-ps-slate-900">Escolha onde deseja entrar</h1>
    <p class="mt-2 text-sm text-ps-slate-500">
      Seu usuário está vinculado a mais de uma organização.
    </p>
  </div>

  <div class="space-y-3">
    <% @memberships.each do |membership| %>
      <% organization = membership.organization %>
      <% kind_label = { "hospital" => "Hospital", "clinica" => "Clínica", "autonomo" => "Autônomo" }.fetch(organization.kind, "Organização") %>
      <% location = [organization.city, organization.state].compact_blank.join(" / ") %>
      <% subtitle = [kind_label, persona_label_for_membership(membership), location.presence].compact.join(" · ") %>
      <%= button_to choose_organization_path,
            method: :post,
            params: { organization_id: organization.id },
            class: "group flex w-full cursor-pointer items-center gap-4 rounded-2xl border border-ps-border bg-white/90 px-4 py-4 text-left shadow-sm backdrop-blur transition hover:border-ps-blue-500 hover:shadow-md focus:border-ps-blue-500 focus:outline-none focus:ring-4 focus:ring-ps-blue-500/15" do %>
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#eef4ff] text-base font-bold text-ps-blue-700 transition group-hover:bg-ps-blue-600 group-hover:text-white">
          <%= organization.name.to_s.strip.first&.upcase %>
        </span>
        <span class="min-w-0 flex-1">
          <span class="block truncate text-sm font-bold text-ps-slate-900"><%= organization.name %></span>
          <span class="mt-0.5 block truncate text-xs text-ps-slate-500"><%= subtitle %></span>
        </span>
        <svg class="h-5 w-5 shrink-0 text-ps-slate-500 transition group-hover:translate-x-0.5 group-hover:text-ps-blue-600" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7.5 4.5 13 10l-5.5 5.5" />
        </svg>
      <% end %>
    <% end %>
  </div>

  <div class="mt-8 text-center">
    <%= button_to "Sair", destroy_user_session_path, method: :delete,
          class: "cursor-pointer text-sm font-semibold text-ps-slate-500 hover:text-ps-blue-700" %>
  </div>
</section>
