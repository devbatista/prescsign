<% content_for :title, "Nova organização · PrescSign" %>

<section class="rounded-2xl border border-ps-border bg-gradient-to-br from-white to-[#f6faff] p-6 shadow-sm">
  <p class="text-xs font-bold uppercase tracking-wider text-[#4a6b93]">Organizações</p>
  <h1 class="mt-1 text-2xl font-bold tracking-tight text-ps-slate-900 sm:text-3xl">Nova Organização</h1>
  <p class="mt-1 text-sm text-ps-slate-500">Você entra como responsável (owner) e um convite é enviado ao e-mail informado.</p>
</section>

<section class="mt-6 max-w-4xl rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
  <%= form_with model: @organization, url: organizations_path, method: :post, class: "space-y-6" do |f| %>
    <% if @organization.errors.any? %>
      <div class="rounded-lg border border-ps-error-border bg-ps-error-bg px-3 py-2 text-sm text-ps-error-fg">
        <%= @organization.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <!-- Identity -->
    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-[#4a6b93]">Identificação</h2>
      <div class="mt-3 grid gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :name, "Nome de exibição", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :name, required: true,
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
        <div>
          <%= f.label :kind, "Tipo", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.select :kind, [["Clínica", "clinica"], ["Autônomo", "autonomo"], ["Hospital", "hospital"]], { selected: @organization.kind },
                required: true, class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
        <div>
          <%= f.label :legal_name, "Razão social", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :legal_name,
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
          <p class="mt-1 text-xs text-ps-slate-500">Obrigatório para clínica/hospital.</p>
        </div>
        <div>
          <%= f.label :trade_name, "Nome fantasia", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :trade_name,
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
        <div>
          <%= f.label :cnpj, "CNPJ", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :cnpj, inputmode: "numeric", placeholder: "somente números (14 dígitos)",
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
          <p class="mt-1 text-xs text-ps-slate-500">Obrigatório para clínica/hospital.</p>
        </div>
        <div>
          <%= f.label :email, "E-mail da organização", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.email_field :email,
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
      </div>
    </div>

    <!-- Responsible -->
    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-[#4a6b93]">Responsável</h2>
      <div class="mt-3 grid gap-5 sm:grid-cols-2">
        <div>
          <label for="organization_responsible_email" class="block text-sm font-semibold text-ps-slate-700">E-mail do responsável</label>
          <%= email_field_tag "organization[responsible_email]", @responsible_email, id: "organization_responsible_email", required: true,
                placeholder: "responsavel@exemplo.com",
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
          <p class="mt-1 text-xs text-ps-slate-500">Recebe um convite de cadastro (expira em 7 dias).</p>
        </div>
        <div>
          <%= f.label :phone, "Telefone", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.telephone_field :phone,
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
      </div>
    </div>

    <!-- Address -->
    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-[#4a6b93]">Endereço</h2>
      <div class="mt-3 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <div>
          <%= f.label :zip_code, "CEP", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :zip_code, inputmode: "numeric",
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
        <div class="lg:col-span-2">
          <%= f.label :street, "Rua", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :street,
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
        <div>
          <%= f.label :number, "Número", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :number,
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
        <div>
          <%= f.label :complement, "Complemento", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :complement,
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
        <div>
          <%= f.label :district, "Bairro", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :district,
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
        <div>
          <%= f.label :city, "Cidade", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :city,
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
        <div>
          <%= f.label :state, "Estado (UF)", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :state, maxlength: 2, placeholder: "SP",
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm uppercase outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
        <div>
          <%= f.label :country, "País", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :country, maxlength: 2, placeholder: "BR",
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm uppercase outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
      </div>
    </div>

    <div class="flex gap-2">
      <%= f.submit "Criar organização", class: "ps-btn-primary cursor-pointer rounded-lg px-4 py-2.5 text-sm font-semibold" %>
      <%= link_to "Cancelar", app_root_path, class: "rounded-lg border border-ps-border px-4 py-2.5 text-sm font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
    </div>
  <% end %>
</section>
