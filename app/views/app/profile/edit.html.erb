<% content_for :title, "Editar perfil · PrescSign" %>

<section class="rounded-2xl border border-ps-border bg-gradient-to-br from-white to-[#f6faff] p-6 shadow-sm">
  <p class="text-xs font-bold uppercase tracking-wider text-[#4a6b93]">Meu Perfil</p>
  <h1 class="mt-1 text-2xl font-bold tracking-tight text-ps-slate-900 sm:text-3xl">Editar Dados</h1>
  <p class="mt-1 text-sm text-ps-slate-500">Atualize seus dados profissionais e credenciais de acesso.</p>
</section>

<section class="mt-6 max-w-3xl rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
  <%= form_with model: @profile, url: profile_path, method: :patch, scope: :doctor, class: "space-y-6" do |f| %>
    <% if @profile.errors.any? || current_user.errors.any? %>
      <div class="rounded-lg border border-ps-error-border bg-ps-error-bg px-3 py-2 text-sm text-ps-error-fg">
        <%= (@profile.errors.full_messages + current_user.errors.full_messages).to_sentence %>
      </div>
    <% end %>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-[#4a6b93]">Dados profissionais</h2>
      <div class="mt-3 grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <%= f.label :full_name, "Nome completo", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :full_name, value: @profile.full_name, required: true,
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
        <div>
          <%= f.label :cpf, "CPF", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :cpf, value: @profile.cpf, inputmode: "numeric",
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
        <div>
          <%= f.label :gender, "Gênero", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.select :gender, [["Masculino", "male"], ["Feminino", "female"]], { include_blank: "Não informar", selected: @profile.gender },
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
        <div>
          <%= f.label :license_number, "CRM", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :license_number, value: @profile.license_number, required: true,
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
        <div>
          <%= f.label :license_state, "UF do CRM", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.text_field :license_state, value: @profile.license_state, maxlength: 2, required: true,
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm uppercase outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
      </div>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-[#4a6b93]">Especialidades</h2>
      <p class="mt-1 text-xs text-ps-slate-500">Escolha uma existente ou digite uma nova. Marque "Remover" para excluir.</p>
      <div class="mt-3 space-y-3">
        <%= f.fields_for :doctor_specialties do |sf| %>
          <%= render "app/shared/specialty_fields", sf: sf %>
        <% end %>
      </div>
      <datalist id="specialties-list">
        <% @specialties.each do |specialty| %>
          <option value="<%= specialty.name %>"></option>
        <% end %>
      </datalist>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-[#4a6b93]">Acesso</h2>
      <div class="mt-3 grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <%= f.label :email, "E-mail", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.email_field :email, value: current_user.email, required: true,
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
        <div>
          <%= f.label :password, "Nova senha", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.password_field :password, autocomplete: "new-password",
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
          <p class="mt-1 text-xs text-ps-slate-500">Deixe em branco para manter a atual.</p>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirmar nova senha", class: "block text-sm font-semibold text-ps-slate-700" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
        </div>
      </div>
    </div>

    <div class="flex gap-2">
      <%= f.submit "Salvar", class: "ps-btn-primary cursor-pointer rounded-lg px-4 py-2.5 text-sm font-semibold" %>
      <%= link_to "Cancelar", profile_path, class: "rounded-lg border border-ps-border px-4 py-2.5 text-sm font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
    </div>
  <% end %>
</section>
