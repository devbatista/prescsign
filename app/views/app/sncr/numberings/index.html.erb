<% content_for :title, "Numerações SNCR · PrescSign" %>

<!-- Header -->
<section class="rounded-2xl border border-ps-border bg-gradient-to-br from-white to-[#f6faff] p-6 shadow-sm">
  <p class="text-xs font-bold uppercase tracking-wider text-[#4a6b93]">SNCR · Anvisa</p>
  <h1 class="mt-1 text-2xl font-bold tracking-tight text-ps-slate-900 sm:text-3xl">Numerações de Controlados</h1>
  <p class="mt-1 text-sm text-ps-slate-500">
    Conecte-se ao Gov.br e obtenha lotes de numeração nacional para emitir receitas de controlados.
    As numerações ficam no seu pool e são consumidas na emissão.
  </p>
</section>

<% if @fake %>
  <div class="mt-6 rounded-lg border border-ps-warning-border bg-ps-warning-bg px-4 py-3 text-sm text-ps-warning-fg">
    <strong class="font-semibold">Modo simulado (SNCR_FAKE).</strong>
    As numerações desta tela são geradas localmente, não vêm da Anvisa e não têm
    validade sanitária. Use apenas para testar o fluxo de emissão.
  </div>
<% end %>

<!-- Conexão Gov.br -->
<section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold text-ps-slate-900">Conexão com o Gov.br</h2>
      <% if @connected %>
        <p class="mt-1 flex items-center gap-2 text-sm text-ps-success-fg">
          <span class="inline-block h-2 w-2 rounded-full bg-ps-success-fg"></span>
          <%= @fake ? "Conectado em modo simulado. Você já pode solicitar numerações de teste." : "Conectado. Você já pode solicitar numerações." %>
        </p>
      <% elsif @fake %>
        <p class="mt-1 text-sm text-ps-slate-500">
          Em modo simulado o Gov.br não é acionado: o botão abaixo apenas libera a solicitação de numerações de teste.
        </p>
      <% else %>
        <p class="mt-1 text-sm text-ps-slate-500">
          Você precisa autenticar no Gov.br para solicitar numerações ao SNCR.
        </p>
      <% end %>
    </div>
    <%= link_to (@connected ? "Reconectar" : (@fake ? "Conectar (simulado)" : "Conectar ao Gov.br")),
          sncr_auth_start_path(state: sncr_numberings_path(sncr_type: @requested_type, return_to: @return_to)),
          class: "ps-btn-primary rounded-lg px-4 py-2 text-sm font-semibold" %>
  </div>
</section>

<!-- Reabastecimento automático -->
<section class="mt-6 rounded-2xl border border-ps-border bg-white p-5 shadow-sm">
  <h2 class="text-sm font-semibold text-ps-slate-900">Reabastecimento automático</h2>
  <% if @refill_types.blank? %>
    <p class="mt-1 text-sm text-ps-slate-500">
      Nada a reabastecer agora. O sistema repõe sozinho apenas os tipos que você já usou
      e que estejam com saldo baixo, respeitando os limites da Anvisa.
    </p>
  <% elsif @connected %>
    <p class="mt-1 text-sm text-ps-success-fg">
      Ativo para <strong class="font-semibold"><%= @refill_types.to_sentence %></strong> —
      tipos que você usa e estão com saldo baixo.
    </p>
  <% else %>
    <p class="mt-1 text-sm text-ps-warning-fg">
      <strong class="font-semibold"><%= @refill_types.to_sentence %></strong> com saldo baixo.
      A reposição automática só acontece com a conexão do Gov.br ativa — ela expira em cerca de uma hora.
    </p>
  <% end %>
</section>

<!-- Saldo por tipo -->
<section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
  <h2 class="text-lg font-semibold text-ps-slate-900">Saldo por tipo de receita</h2>
  <p class="mt-1 text-sm text-ps-slate-500">Quantidade de numerações disponíveis no seu pool e quanto da cota da Anvisa já foi usada.</p>

  <div class="mt-4 overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b border-ps-border text-xs uppercase tracking-wide text-ps-slate-500">
          <th class="py-2 pr-4">Tipo</th>
          <th class="py-2 pr-4">Descrição</th>
          <th class="py-2 pr-4 text-right">Disponível</th>
          <th class="py-2 pr-4 text-right">Na Anvisa</th>
          <th class="py-2 pr-4">Cota</th>
          <th class="py-2 pl-4 text-right">Ação</th>
        </tr>
      </thead>
      <tbody>
        <% @types.each do |type| %>
          <% blocked_reason = @quota.block_reason(type) %>
          <% highlighted = @requested_type == type %>
          <tr id="tipo-<%= type %>" class="border-b border-ps-border/60 <%= 'bg-[#fffbeb] outline outline-2 outline-ps-warning-border' if highlighted %>">
            <td class="py-3 pr-4 font-semibold text-ps-slate-900"><%= type %></td>
            <td class="py-3 pr-4 text-ps-slate-600">
              <%= @type_labels[type] %>
              <% if (aviso = @quota.remote_message(type)).present? %>
                <span class="mt-1 block text-xs text-ps-warning-fg">Anvisa: <%= aviso %></span>
              <% end %>
            </td>
            <td class="py-3 pr-4 text-right font-semibold tabular-nums text-ps-slate-900"><%= @balance.fetch(type, 0) %></td>
            <td class="py-3 pr-4 text-right tabular-nums text-ps-slate-600">
              <%= sncr_remote_balance_summary(@quota, type) || "—" %>
            </td>
            <td class="py-3 pr-4 text-xs text-ps-slate-500"><%= sncr_quota_summary(@quota, type) %></td>
            <td class="py-3 pl-4 text-right">
              <% if blocked_reason %>
                <span class="inline-block cursor-not-allowed rounded-lg border border-ps-border bg-[#f7f8fa] px-3 py-1.5 text-sm font-medium text-ps-slate-400"
                      title="<%= blocked_reason %>">Solicitar</span>
                <span class="mt-1 block text-xs text-ps-slate-500"><%= blocked_reason %></span>
              <% else %>
                <%= button_to "Solicitar", sncr_numberings_path, method: :post,
                      params: { sncr_type: type, return_to: @return_to },
                      form: { data: { turbo_confirm: (["RCE", "RET"].include?(type) ? "Isto consome uma das 3 solicitações de RCE/RET do mês. Confirmar?" : nil) } },
                      class: "cursor-pointer rounded-lg border border-ps-border px-3 py-1.5 text-sm font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @return_to.present? %>
    <p class="mt-4 text-sm">
      <%= link_to "← Voltar ao documento", @return_to, class: "font-medium text-[#2c5aa0] hover:underline" %>
    </p>
  <% end %>

  <p class="mt-4 text-xs text-ps-slate-500">
    Notificação de Receita (NRA–NRT) libera até 50 números por tipo por dia;
    Controle Especial/Retenção (RCE, RET) libera blocos de 1.000, com limite de 3 solicitações por mês
    somando os dois tipos.
  </p>
</section>

<!-- Histórico de solicitações -->
<% if @recent_requests.any? %>
  <section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-ps-slate-900">Últimas solicitações</h2>
    <p class="mt-1 text-sm text-ps-slate-500">É por elas que a cota da Anvisa é contada.</p>

    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-ps-border text-xs uppercase tracking-wide text-ps-slate-500">
            <th class="py-2 pr-4">Data</th>
            <th class="py-2 pr-4">Tipo</th>
            <th class="py-2 pr-4">Origem</th>
            <th class="py-2 pr-4 text-right">Números</th>
            <th class="py-2 pl-4">Desfecho</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_requests.each do |request| %>
            <tr class="border-b border-ps-border/60">
              <td class="py-3 pr-4 whitespace-nowrap text-ps-slate-600"><%= l(request.requested_at, format: :short) %></td>
              <td class="py-3 pr-4 font-medium text-ps-slate-900"><%= request.sncr_type %></td>
              <td class="py-3 pr-4 text-ps-slate-600"><%= sncr_request_origin_label(request) %></td>
              <td class="py-3 pr-4 text-right tabular-nums text-ps-slate-600"><%= request.imported_count || "—" %></td>
              <td class="py-3 pl-4">
                <span class="inline-block rounded-full px-2 py-0.5 text-xs font-medium <%= sncr_request_status_classes(request) %>">
                  <%= sncr_request_status_label(request) %>
                </span>
                <% if request.status == "unknown" %>
                  <span class="mt-1 block text-xs text-ps-slate-500">
                    A Anvisa pode ter contabilizado esta solicitação.
                  </span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
