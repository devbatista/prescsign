<% content_for :title, "Médicos · PrescSign" %>

<!-- Header -->
<section class="rounded-2xl border border-ps-border bg-gradient-to-br from-white to-[#f6faff] p-6 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-[#4a6b93]">Médicos</p>
      <h1 class="mt-1 text-2xl font-bold tracking-tight text-ps-slate-900 sm:text-3xl">Médicos</h1>
      <p class="mt-1 text-sm text-ps-slate-500">Consulte os médicos ativos e cadastre novos.</p>
    </div>
    <%= link_to "Cadastrar médico", new_doctor_path, class: "ps-btn-primary rounded-lg px-4 py-2 text-sm font-semibold" %>
  </div>
</section>

<!-- Doctors -->
<section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
  <h2 class="text-lg font-bold text-ps-slate-900">Médicos Ativos</h2>
  <% if @doctors.any? %>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-ps-border text-ps-slate-500">
            <th class="py-2 font-medium">Nome</th>
            <th class="py-2 font-medium">E-mail</th>
            <th class="py-2 font-medium">CRM</th>
            <th class="py-2 font-medium">Especialidade</th>
            <th class="py-2 font-medium">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @doctors.each do |doctor| %>
            <tr class="border-b border-ps-border/60">
              <td class="py-3 font-medium text-ps-slate-900"><%= doctor.full_name %></td>
              <td class="py-3 text-ps-slate-700"><%= doctor.email.presence || "—" %></td>
              <td class="py-3 text-ps-slate-700"><%= [doctor.license_number, doctor.license_state].compact.join(" / ").presence || "—" %></td>
              <td class="py-3 text-ps-slate-700"><%= doctor.specialty_label.presence || "—" %></td>
              <td class="py-3">
                <% if doctor.active %>
                  <span class="rounded-full bg-ps-success-bg px-2 py-0.5 text-xs font-medium text-ps-success-fg">Ativo</span>
                <% else %>
                  <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-ps-slate-500">Inativo</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "shared/pagination" %>
  <% else %>
    <p class="mt-4 rounded-lg border border-dashed border-ps-border p-4 text-sm text-ps-slate-500">
      Nenhum médico ativo nesta organização ainda.
    </p>
  <% end %>
</section>
