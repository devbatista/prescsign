<% content_for :title, "Documento #{@document.code} · PrescSign" %>
<% signature = @document.metadata["signature"].presence %>

<!-- Header -->
<section class="rounded-2xl border border-ps-border bg-gradient-to-br from-white to-[#f6faff] p-6 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-[#4a6b93]"><%= document_kind_label(@document.kind) %> · <%= @document.code %></p>
      <h1 class="mt-1 text-2xl font-bold tracking-tight text-ps-slate-900 sm:text-3xl"><%= @document.patient.full_name %></h1>
      <p class="mt-2 flex flex-wrap items-center gap-2 text-sm text-ps-slate-500">
        <%= document_status_pill(@document.status) %>
        <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-ps-slate-600"><%= documentable_status_label(@documentable.status) %></span>
        <span>Versão <%= @document.current_version %></span>
      </p>
    </div>
    <%= link_to "Voltar ao paciente", patient_path(@document.patient), class: "rounded-lg border border-ps-border px-4 py-2 text-sm font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
  </div>
</section>

<!-- Actions -->
<section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
  <h2 class="text-lg font-bold text-ps-slate-900">Ações</h2>
  <div class="mt-4 flex flex-wrap gap-2">
    <% if policy(@documentable).pdf? %>
      <%= link_to "Baixar PDF", documentable_pdf_path(@documentable), target: "_blank", rel: "noopener",
            class: "rounded-lg border border-ps-border px-4 py-2 text-sm font-semibold text-ps-slate-700 hover:bg-[#f4f7fc]" %>
    <% end %>

    <% if @documentable.status == "draft" && policy(@documentable).update? %>
      <%= link_to "Editar", documentable_edit_path(@documentable), class: "rounded-lg border border-ps-border px-4 py-2 text-sm font-semibold text-ps-blue-700 hover:bg-[#eef4ff]" %>
    <% end %>

    <% if policy(@document).sign? %>
      <%= button_tag "Assinar documento", type: "button",
            onclick: "document.getElementById('sign-pin-modal').showModal()",
            class: "ps-btn-primary cursor-pointer rounded-lg px-4 py-2 text-sm font-semibold" %>

      <dialog id="sign-pin-modal" class="fixed left-1/2 top-1/2 m-0 w-[min(420px,calc(100vw-2rem))] -translate-x-1/2 -translate-y-1/2 rounded-2xl border border-ps-border bg-white p-0 shadow-2xl backdrop:bg-ps-slate-900/80">
        <%# onsubmit (via html:, senão o form_with descarta): trava duplo-submit,
            desabilita os botões e mostra spinner + "Assinando…". %>
        <%= form_with url: sign_document_path(@document), method: :patch, data: { turbo: false },
              html: { onsubmit: "if(this.dataset.busy){return false}; this.dataset.busy='1'; " \
                        "this.querySelectorAll('button').forEach(function(el){el.disabled=true}); " \
                        "var sp=this.querySelector('[data-sign-spinner]'); if(sp){sp.classList.remove('hidden')}; " \
                        "var lb=this.querySelector('[data-sign-label]'); if(lb){lb.textContent='Assinando…'};" } do |f| %>
          <div class="p-6">
            <div class="mb-4 flex items-start justify-between gap-4">
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-[#4a6b93]">Assinatura digital</p>
                <h2 class="mt-1 text-xl font-bold tracking-tight text-ps-slate-900">Assinar documento</h2>
                <p class="mt-1 text-sm text-ps-slate-500">Informe o PIN do seu certificado para assinar. Ele não é armazenado.</p>
              </div>
              <%= button_tag "Fechar", type: "button", onclick: "this.closest('dialog').close()",
                    class: "cursor-pointer rounded-lg border border-ps-border px-3 py-2 text-sm font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
            </div>

            <%= f.label :pin, "PIN do certificado", class: "block text-sm font-medium text-ps-slate-700" %>
            <%= f.password_field :pin, autocomplete: "off", required: true, autofocus: true, inputmode: "numeric",
                  class: "mt-1 w-full rounded-lg border border-ps-border px-3 py-2 text-sm focus:border-ps-blue-500 focus:outline-none focus:ring-2 focus:ring-ps-blue-200" %>

            <p class="mt-3 text-xs text-ps-slate-500">A assinatura pode levar alguns segundos. Não feche esta janela.</p>

            <div class="mt-6 flex justify-end gap-2">
              <%= button_tag "Cancelar", type: "button", onclick: "this.closest('dialog').close()",
                    class: "cursor-pointer rounded-lg border border-ps-border px-4 py-2 text-sm font-semibold text-ps-slate-700 hover:bg-[#f4f7fc] disabled:cursor-not-allowed disabled:opacity-50" %>
              <button type="submit" class="ps-btn-primary inline-flex cursor-pointer items-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold disabled:cursor-not-allowed disabled:opacity-70">
                <svg data-sign-spinner class="hidden h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                <span data-sign-label>Assinar</span>
              </button>
            </div>
          </div>
        <% end %>
      </dialog>
    <% end %>

    <% if @document.signed_at.present? && policy(@document).integrity_check? %>
      <%= button_to "Verificar integridade", integrity_check_document_path(@document), method: :patch,
            class: "cursor-pointer rounded-lg border border-ps-border px-4 py-2 text-sm font-semibold text-ps-slate-700 hover:bg-[#f4f7fc]" %>
    <% end %>

    <% if @documentable.status != "cancelled" && policy(@documentable).revoke? %>
      <%= button_tag "Revogar", type: "button",
            onclick: "document.getElementById('revoke-modal').showModal()",
            class: "cursor-pointer rounded-lg border border-ps-error-border px-4 py-2 text-sm font-semibold text-ps-error-fg hover:bg-ps-error-bg" %>

      <dialog id="revoke-modal" class="fixed left-1/2 top-1/2 m-0 w-[min(420px,calc(100vw-2rem))] -translate-x-1/2 -translate-y-1/2 rounded-2xl border border-ps-border bg-white p-0 shadow-2xl backdrop:bg-ps-slate-900/80">
        <%= form_with url: documentable_revoke_path(@documentable), method: :patch, data: { turbo: false } do |f| %>
          <div class="p-6">
            <div class="mb-4">
              <p class="text-xs font-bold uppercase tracking-wider text-ps-error-fg">Revogação</p>
              <h2 class="mt-1 text-xl font-bold tracking-tight text-ps-slate-900">Revogar documento</h2>
              <p class="mt-1 text-sm text-ps-slate-500">Esta ação não pode ser desfeita. Informe o motivo da revogação — ele fica registrado na auditoria.</p>
            </div>

            <%= f.label :reason, "Motivo da revogação", class: "block text-sm font-medium text-ps-slate-700" %>
            <%= f.text_area :reason, rows: 3, required: true, autofocus: true,
                  placeholder: "Ex.: erro de dosagem, medicamento trocado, receita duplicada…",
                  class: "mt-1 w-full rounded-lg border border-ps-border px-3 py-2 text-sm focus:border-ps-blue-500 focus:outline-none focus:ring-2 focus:ring-ps-blue-200" %>

            <div class="mt-6 flex justify-end gap-2">
              <%= button_tag "Cancelar", type: "button", onclick: "this.closest('dialog').close()",
                    class: "cursor-pointer rounded-lg border border-ps-border px-4 py-2 text-sm font-semibold text-ps-slate-700 hover:bg-[#f4f7fc]" %>
              <button type="submit" class="cursor-pointer rounded-lg border border-ps-error-border bg-ps-error-bg px-4 py-2 text-sm font-semibold text-ps-error-fg hover:opacity-90">Revogar documento</button>
            </div>
          </div>
        <% end %>
      </dialog>
    <% end %>
  </div>
</section>

<!-- Document data -->
<section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
  <h2 class="text-lg font-bold text-ps-slate-900">Dados do Documento</h2>
  <dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% [
         ["Tipo", document_kind_label(@document.kind)],
         ["Código", @document.code],
         ["Paciente", @document.patient.full_name],
         ["Estado do documento", document_status_label(@document.status)],
         ["Estado do conteúdo", documentable_status_label(@documentable.status)],
         ["Versão atual", @document.current_version],
         ["Emitido em", @document.issued_on&.strftime("%d/%m/%Y")],
         ["Assinado em", @document.signed_at&.strftime("%d/%m/%Y %H:%M") || "—"],
         ["Cancelado em", @document.cancelled_at&.strftime("%d/%m/%Y %H:%M") || "—"]
       ].each do |label, value| %>
      <div class="rounded-xl border border-ps-border bg-[#f9fbff] p-4">
        <dt class="text-sm text-ps-slate-500"><%= label %></dt>
        <dd class="mt-1 font-semibold text-ps-slate-900"><%= value %></dd>
      </div>
    <% end %>
  </dl>

  <div class="mt-4 rounded-xl border border-ps-border bg-[#f9fbff] p-4">
    <dt class="text-sm text-ps-slate-500">Conteúdo clínico</dt>
    <dd class="mt-1 whitespace-pre-line text-ps-slate-900"><%= @documentable.content.presence || "—" %></dd>
  </div>
</section>

<!-- Signature -->
<% if signature %>
  <section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-ps-slate-900">Assinatura Digital</h2>
    <dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% {
           "Método" => signature["method"], "Provedor" => signature["provider"], "Política" => signature["policy"],
           "Titular do certificado" => signature["certificate_subject"], "Emissor" => signature["certificate_issuer"],
           "Carimbo do tempo" => (signature["timestamped"].nil? ? nil : (signature["timestamped"] ? "Sim" : "Não")),
           "Status de validação" => signature["validation_status"]
         }.compact.each do |label, value| %>
        <div class="rounded-xl border border-ps-border bg-[#f9fbff] p-4">
          <dt class="text-sm text-ps-slate-500"><%= label %></dt>
          <dd class="mt-1 break-words font-medium text-ps-slate-900"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </section>
<% end %>

<!-- Versions -->
<section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
  <h2 class="text-lg font-bold text-ps-slate-900">Versões</h2>
  <div class="mt-4 overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b border-ps-border text-ps-slate-500">
          <th class="py-2 font-medium">Versão</th>
          <th class="py-2 font-medium">Checksum</th>
          <th class="py-2 font-medium">Gerada em</th>
        </tr>
      </thead>
      <tbody>
        <% @versions.each do |version| %>
          <tr class="border-b border-ps-border/60">
            <td class="py-3 font-medium text-ps-slate-900">v<%= version.version_number %></td>
            <td class="py-3 font-mono text-xs text-ps-slate-500"><%= version.checksum&.first(16) %>…</td>
            <td class="py-3 text-ps-slate-700"><%= version.generated_at&.strftime("%d/%m/%Y %H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "shared/pagination",
        page: @versions_page,
        total_pages: @versions_total_pages,
        total: @versions_total,
        page_param: :versions_page %>
</section>

<!-- Resend -->
<% if policy(@document).resend? %>
  <section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-ps-slate-900">Enviar ao Paciente</h2>
    <% if @last_delivery.present? %>
      <p class="mt-1 text-sm text-ps-slate-600">
        Último envio: <%= @last_delivery.recipient %> via <%= @last_delivery.channel %>
        em <%= @last_delivery.attempted_at&.strftime("%d/%m/%Y %H:%M") %>.
      </p>
    <% end %>
    <%= form_with url: resend_document_path(@document), method: :post, class: "mt-4 flex flex-wrap items-end gap-4" do %>
      <div>
        <label class="block text-sm font-medium text-ps-slate-700">Canal</label>
        <%= select_tag :channel,
              options_for_select(@delivery_channel_options),
              class: "mt-1 rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
      </div>
      <div class="grow">
        <label class="block text-sm font-medium text-ps-slate-700">Destinatário (opcional)</label>
        <%= text_field_tag :recipient, nil, placeholder: "Deixe vazio para usar o contato do paciente",
              class: "mt-1 w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
      </div>
      <%= submit_tag "Enviar", class: "ps-btn-primary cursor-pointer rounded-lg px-4 py-2 text-sm font-semibold" %>
    <% end %>
  </section>
<% elsif @document.signed_at.blank? %>
  <section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-ps-slate-900">Enviar ao Paciente</h2>
    <p class="mt-2 text-sm text-ps-slate-600">Disponível após a assinatura do documento.</p>
  </section>
<% end %>
