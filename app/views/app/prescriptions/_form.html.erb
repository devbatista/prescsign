<%= form_with model: prescription, url: (prescription.persisted? ? prescription_path(prescription) : prescriptions_path),
      method: (prescription.persisted? ? :patch : :post), class: "space-y-6" do |f| %>
  <% if prescription.errors.any? %>
    <div class="rounded-lg border border-ps-error-border bg-ps-error-bg px-3 py-2 text-sm text-ps-error-fg">
      <%= prescription.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-[#4a6b93]">Receita</h2>
    <p class="mt-1 text-xs text-ps-slate-500">Defina paciente, emissão e validade do documento.</p>

    <div class="mt-3 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <%= f.label :patient_id, "Paciente", class: "block text-sm font-semibold text-ps-slate-700" %>
        <% if prescription.persisted? %>
          <p class="mt-2 rounded-lg border border-ps-border bg-[#f9fbff] px-3 py-2 text-sm text-ps-slate-900"><%= prescription.patient.full_name %></p>
        <% elsif patients.one? %>
          <p class="mt-2 rounded-lg border border-ps-border bg-[#f9fbff] px-3 py-2 text-sm text-ps-slate-900"><%= patients.first.full_name %></p>
          <%= f.hidden_field :patient_id, value: patients.first.id %>
        <% else %>
          <%= f.collection_select :patient_id, patients, :id, :full_name,
                { include_blank: "Selecione um paciente" },
                { required: true, class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" } %>
        <% end %>
      </div>

      <div>
        <%= f.label :issued_on, "Data de emissão", class: "block text-sm font-semibold text-ps-slate-700" %>
        <%= f.date_field :issued_on, required: true,
              class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
      </div>

      <div>
        <%= f.label :valid_until, "Válido até (opcional)", class: "block text-sm font-semibold text-ps-slate-700" %>
        <%= f.date_field :valid_until,
              class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
      </div>

      <%# Campo de leitura, sempre: o tipo de receituário sai da substância do
          medicamento prescrito (`Prescription#sync_sncr_type_from_items`), nunca
          da escolha do médico — por isso não há select nem `sncr_type` nos params
          da requisição. Receita sem medicamento controlado do catálogo sai comum. %>
      <% derived_types = prescription.resolved_item_sncr_types %>
      <% derived_type = derived_types.first if derived_types.one? %>
      <div class="lg:col-span-4"
           data-sncr-field
           data-sncr-labels="<%= Prescription::SNCR_TYPE_LABELS.to_json %>"
           data-sncr-conflict-template="Os medicamentos escolhidos exigem receituários diferentes (%{tipos}). Cada tipo tem receituário próprio — emita uma receita para cada."
           data-sncr-hint-derived="Definido pelo medicamento prescrito. Um número do seu pool SNCR é consumido na assinatura; sem saldo, a assinatura é bloqueada até você obter numeração."
           data-sncr-hint-common="Definido pelo medicamento prescrito: escolha um controlado no catálogo para a receita virar controlada.">
        <span class="block text-sm font-semibold text-ps-slate-700">Tipo de receita controlada (SNCR/Anvisa)</span>

        <p class="mt-2 rounded-lg border border-ps-border bg-[#f9fbff] px-3 py-2 text-sm text-ps-slate-900 <%= "hidden" if derived_type.nil? %>"
           data-sncr-derived>
          <span data-sncr-derived-text><%= "#{derived_type} — #{Prescription::SNCR_TYPE_LABELS[derived_type]}" if derived_type %></span>
          <% if prescription.sncr_numbering %>
            · nº <span class="font-semibold tabular-nums"><%= prescription.sncr_numbering.number %></span>
          <% end %>
        </p>

        <p class="mt-2 rounded-lg border border-ps-error-border bg-ps-error-bg px-3 py-2 text-sm text-ps-error-fg <%= "hidden" unless derived_types.many? %>"
           data-sncr-conflict>
          <span data-sncr-conflict-text>
            <%= "Os medicamentos escolhidos exigem receituários diferentes (#{derived_types.join(', ')}). Cada tipo tem receituário próprio — emita uma receita para cada." if derived_types.many? %>
          </span>
        </p>

        <p class="mt-2 rounded-lg border border-ps-border bg-[#f9fbff] px-3 py-2 text-sm text-ps-slate-600 <%= "hidden" if derived_types.any? %>"
           data-sncr-common>
          Receita comum (sem numeração SNCR)
        </p>

        <p class="mt-1 text-xs text-ps-slate-500 <%= "hidden" if derived_types.many? %>" data-sncr-hint>
          <%= derived_types.any? ? "Definido pelo medicamento prescrito. Um número do seu pool SNCR é consumido na assinatura; sem saldo, a assinatura é bloqueada até você obter numeração." : "Definido pelo medicamento prescrito: escolha um controlado no catálogo para a receita virar controlada." %>
        </p>
      </div>
    </div>
  </div>

  <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-[#4a6b93]">Medicamentos</h2>
    <p class="mt-1 text-xs text-ps-slate-500">Busque no catálogo (os campos são preenchidos automaticamente) ou digite manualmente.</p>

    <div class="mt-3" data-prescription-item-fields>
      <div class="space-y-4" data-prescription-item-fields-list>
        <%= f.fields_for :prescription_items do |pf| %>
          <%= render "app/prescriptions/item_fields", pf: pf %>
        <% end %>
      </div>

      <template data-prescription-item-template>
        <%= f.fields_for :prescription_items, PrescriptionItem.new, child_index: "NEW_RECORD" do |pf| %>
          <%= render "app/prescriptions/item_fields", pf: pf %>
        <% end %>
      </template>

      <button type="button" class="mt-4 rounded-lg border border-ps-border px-4 py-2.5 text-sm font-semibold text-ps-blue-700 hover:bg-[#eef4ff]" data-add-prescription-item>
        Adicionar medicamento
      </button>
    </div>
  </div>

  <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-[#4a6b93]">Orientações gerais (opcional)</h2>
    <p class="mt-1 text-xs text-ps-slate-500">Usado como texto livre da receita quando você não adiciona medicamentos acima. Ao usar os itens, o conteúdo é gerado a partir deles.</p>

    <div class="mt-3 grid gap-5 lg:grid-cols-4">
      <div class="lg:col-span-4">
        <%= f.label :content, "Prescrição / orientações", class: "block text-sm font-semibold text-ps-slate-700" %>
        <%= f.text_area :content, rows: 5, placeholder: "Orientações ao paciente, uso contínuo, observações…",
              class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
      </div>
    </div>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= f.submit (prescription.persisted? ? "Salvar" : "Emitir receita"),
          class: "ps-btn-primary cursor-pointer rounded-lg px-4 py-2.5 text-sm font-semibold" %>
    <% if local_assigns[:modal] %>
      <%= button_tag "Cancelar", type: "button", onclick: "this.closest('dialog').close()",
            class: "cursor-pointer rounded-lg border border-ps-border px-4 py-2.5 text-sm font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
    <% else %>
      <%= link_to "Cancelar", (prescription.persisted? ? document_path(prescription.document) : app_root_path),
            class: "rounded-lg border border-ps-border px-4 py-2.5 text-sm font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
    <% end %>
  </div>
<% end %>
