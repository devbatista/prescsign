<%= form_with model: prescription, url: (prescription.persisted? ? prescription_path(prescription) : prescriptions_path),
      method: (prescription.persisted? ? :patch : :post), class: "space-y-6" do |f| %>
  <% if prescription.errors.any? %>
    <div class="rounded-lg border border-ps-error-border bg-ps-error-bg px-3 py-2 text-sm text-ps-error-fg">
      <%= prescription.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-[#4a6b93]">Receita</h2>
    <p class="mt-1 text-xs text-ps-slate-500">Defina paciente, emissão e validade do documento.</p>

    <div class="mt-3 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <%= f.label :patient_id, "Paciente", class: "block text-sm font-semibold text-ps-slate-700" %>
        <% if prescription.persisted? %>
          <p class="mt-2 rounded-lg border border-ps-border bg-[#f9fbff] px-3 py-2 text-sm text-ps-slate-900"><%= prescription.patient.full_name %></p>
        <% elsif patients.one? %>
          <p class="mt-2 rounded-lg border border-ps-border bg-[#f9fbff] px-3 py-2 text-sm text-ps-slate-900"><%= patients.first.full_name %></p>
          <%= f.hidden_field :patient_id, value: patients.first.id %>
        <% else %>
          <%= f.collection_select :patient_id, patients, :id, :full_name,
                { include_blank: "Selecione um paciente" },
                { required: true, class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" } %>
        <% end %>
      </div>

      <div>
        <%= f.label :issued_on, "Data de emissão", class: "block text-sm font-semibold text-ps-slate-700" %>
        <%= f.date_field :issued_on, required: true,
              class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
      </div>

      <div>
        <%= f.label :valid_until, "Válido até (opcional)", class: "block text-sm font-semibold text-ps-slate-700" %>
        <%= f.date_field :valid_until,
              class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
      </div>

      <div class="lg:col-span-4">
        <%= f.label :sncr_type, "Tipo de receita controlada (SNCR/Anvisa)", class: "block text-sm font-semibold text-ps-slate-700" %>
        <% if prescription.persisted? %>
          <p class="mt-2 rounded-lg border border-ps-border bg-[#f9fbff] px-3 py-2 text-sm text-ps-slate-900">
            <% if prescription.controlled? %>
              <%= prescription.sncr_type %> — <%= Prescription::SNCR_TYPE_LABELS[prescription.sncr_type] %>
              <% if prescription.sncr_numbering %>· nº <span class="font-semibold tabular-nums"><%= prescription.sncr_numbering.number %></span><% end %>
            <% else %>
              Receita comum (sem numeração SNCR)
            <% end %>
          </p>
        <% else %>
          <%= f.select :sncr_type,
                Prescription::SNCR_TYPE_LABELS.map { |type, label| ["#{type} — #{label}", type] },
                { include_blank: "Receita comum (sem numeração SNCR)" },
                { class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" } %>
          <p class="mt-1 text-xs text-ps-slate-500">Ao marcar um tipo controlado, um número do seu pool SNCR é consumido no momento da assinatura. Sem saldo, a assinatura é bloqueada até você obter numeração.</p>
        <% end %>
      </div>
    </div>
  </div>

  <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-[#4a6b93]">Conteúdo clínico</h2>
    <p class="mt-1 text-xs text-ps-slate-500">Informe medicamentos, posologia e orientações ao paciente.</p>

    <div class="mt-3 grid gap-5 lg:grid-cols-4">
      <div class="lg:col-span-4">
        <%= f.label :content, "Prescrição", class: "block text-sm font-semibold text-ps-slate-700" %>
        <%= f.text_area :content, rows: 8, required: true, placeholder: "Medicamentos, posologia e orientações",
              class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
      </div>
    </div>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= f.submit (prescription.persisted? ? "Salvar" : "Emitir receita"),
          class: "ps-btn-primary cursor-pointer rounded-lg px-4 py-2.5 text-sm font-semibold" %>
    <% if local_assigns[:modal] %>
      <%= button_tag "Cancelar", type: "button", onclick: "this.closest('dialog').close()",
            class: "cursor-pointer rounded-lg border border-ps-border px-4 py-2.5 text-sm font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
    <% else %>
      <%= link_to "Cancelar", (prescription.persisted? ? document_path(prescription.document) : app_root_path),
            class: "rounded-lg border border-ps-border px-4 py-2.5 text-sm font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
    <% end %>
  </div>
<% end %>
