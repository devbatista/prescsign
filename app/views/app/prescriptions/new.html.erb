<% content_for :title, "Emitir receita · PrescSign" %>

<section class="rounded-2xl border border-ps-border bg-gradient-to-br from-white to-[#f6faff] p-6 shadow-sm">
  <p class="text-xs font-bold uppercase tracking-wider text-[#4a6b93]">Documentos</p>
  <h1 class="mt-1 text-2xl font-bold tracking-tight text-ps-slate-900 sm:text-3xl">Emitir Receita</h1>
  <p class="mt-1 text-sm text-ps-slate-500">A receita é criada como rascunho e pode ser editada antes da assinatura.</p>
</section>

<section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
  <%= render "form", prescription: @prescription, patients: @patients %>
</section>
