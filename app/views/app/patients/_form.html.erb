<%= form_with model: patient, url: (patient.persisted? ? patient_path(patient) : patients_path),
      method: (patient.persisted? ? :patch : :post), class: "space-y-5" do |f| %>
  <% if patient.errors.any? %>
    <div class="rounded-lg border border-ps-error-border bg-ps-error-bg px-3 py-2 text-sm text-ps-error-fg">
      <%= patient.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <%= f.label :full_name, "Nome completo", class: "block text-sm font-semibold text-ps-slate-700" %>
      <%= f.text_field :full_name, required: true,
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>

    <div>
      <%= f.label :cpf, "CPF", class: "block text-sm font-semibold text-ps-slate-700" %>
      <%= f.text_field :cpf, inputmode: "numeric", placeholder: "000.000.000-00", required: true,
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>

    <div>
      <%= f.label :birth_date, "Data de nascimento", class: "block text-sm font-semibold text-ps-slate-700" %>
      <%= f.date_field :birth_date, required: true,
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>

    <div>
      <%= f.label :email, "E-mail", class: "block text-sm font-semibold text-ps-slate-700" %>
      <%= f.email_field :email,
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>

    <div>
      <%= f.label :phone, "Telefone", class: "block text-sm font-semibold text-ps-slate-700" %>
      <%= f.telephone_field :phone,
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>

    <% if patient.persisted? %>
      <label class="flex items-center gap-2 sm:col-span-2">
        <%= f.check_box :active, class: "h-4 w-4 rounded border-ps-border text-ps-blue-600" %>
        <span class="text-sm text-ps-slate-700">Paciente ativo</span>
      </label>
    <% end %>
  </div>

  <div class="flex gap-2">
    <%= f.submit (patient.persisted? ? "Salvar" : "Cadastrar"),
          class: "ps-btn-primary cursor-pointer rounded-lg px-4 py-2.5 text-sm font-semibold" %>
    <%= link_to "Cancelar", (patient.persisted? ? patient_path(patient) : patients_path),
          class: "rounded-lg border border-ps-border px-4 py-2.5 text-sm font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
  </div>
<% end %>
