<% content_for :title, "#{@patient.full_name} · PrescSign" %>

<!-- Header -->
<section class="rounded-2xl border border-ps-border bg-gradient-to-br from-white to-[#f6faff] p-6 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-[#4a6b93]">Paciente</p>
      <h1 class="mt-1 text-2xl font-bold tracking-tight text-ps-slate-900 sm:text-3xl"><%= @patient.full_name %></h1>
      <p class="mt-1 text-sm text-ps-slate-500">Histórico clínico e documentos emitidos.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Voltar", patients_path, class: "rounded-lg border border-ps-border px-4 py-2 text-sm font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
      <%= link_to "Editar", edit_patient_path(@patient), class: "ps-btn-primary rounded-lg px-4 py-2 text-sm font-semibold" %>
    </div>
  </div>
</section>

<!-- Patient data -->
<section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
  <h2 class="text-lg font-bold text-ps-slate-900">Dados do Paciente</h2>
  <dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% [
         ["Nome", @patient.full_name],
         ["CPF", number_to_cpf(@patient.cpf)],
         ["Nascimento", @patient.birth_date&.strftime("%d/%m/%Y")],
         ["E-mail", @patient.email.presence || "—"],
         ["Telefone", @patient.phone.presence || "—"],
         ["Status", @patient.active ? "Ativo" : "Inativo"]
       ].each do |label, value| %>
      <div class="rounded-xl border border-ps-border bg-[#f9fbff] p-4">
        <dt class="text-sm text-ps-slate-500"><%= label %></dt>
        <dd class="mt-1 font-semibold text-ps-slate-900"><%= value %></dd>
      </div>
    <% end %>
  </dl>
</section>

<!-- Documents -->
<section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
  <h2 class="text-lg font-bold text-ps-slate-900">Documentos Emitidos</h2>

  <% doc_kind = ->(type) { { "Prescription" => "Receita", "MedicalCertificate" => "Atestado" }[type] || type } %>
  <% if @documents.any? %>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-ps-border text-ps-slate-500">
            <th class="py-2 font-medium">Tipo</th>
            <th class="py-2 font-medium">Status</th>
            <th class="py-2 font-medium">Emissão</th>
          </tr>
        </thead>
        <tbody>
          <% @documents.each do |document| %>
            <tr class="border-b border-ps-border/60">
              <td class="py-3 font-medium text-ps-slate-900"><%= doc_kind.call(document.documentable_type) %></td>
              <td class="py-3 text-ps-slate-700"><%= document.status %></td>
              <td class="py-3 text-ps-slate-700"><%= document.created_at.strftime("%d/%m/%Y %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-4 rounded-lg border border-dashed border-ps-border p-4 text-sm text-ps-slate-500">
      Nenhum documento emitido para este paciente.
    </p>
  <% end %>
</section>
