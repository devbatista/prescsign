<%= form_with model: consultation, url: (consultation.persisted? ? consultation_path(consultation) : consultations_path),
      method: (consultation.persisted? ? :patch : :post), class: "space-y-5" do |f| %>
  <% if consultation.errors.any? %>
    <div class="rounded-lg border border-ps-error-border bg-ps-error-bg px-3 py-2 text-sm text-ps-error-fg">
      <%= consultation.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <%= f.label :patient_id, "Paciente", class: "block text-sm font-semibold text-ps-slate-700" %>
      <% if consultation.persisted? %>
        <p class="mt-2 rounded-lg border border-ps-border bg-[#f9fbff] px-3 py-2 text-sm text-ps-slate-900"><%= consultation.patient.full_name %></p>
      <% else %>
        <%= f.collection_select :patient_id, patients, :id, :full_name,
              { include_blank: "Selecione um paciente" },
              { required: true, class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" } %>
      <% end %>
    </div>

    <div>
      <%= f.label :scheduled_at, "Data e hora", class: "block text-sm font-semibold text-ps-slate-700" %>
      <%= f.datetime_field :scheduled_at, required: true,
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>

    <% if consultation.persisted? %>
      <div>
        <%= f.label :status, "Status", class: "block text-sm font-semibold text-ps-slate-700" %>
        <%= f.select :status, consultation_status_options, {},
              class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
      </div>

      <div>
        <%= f.label :finished_at, "Finalizada em", class: "block text-sm font-semibold text-ps-slate-700" %>
        <%= f.datetime_field :finished_at,
              class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
      </div>
    <% end %>

    <div class="sm:col-span-2">
      <%= f.label :chief_complaint, "Queixa principal", class: "block text-sm font-semibold text-ps-slate-700" %>
      <%= f.text_area :chief_complaint, rows: 3, placeholder: "Motivo da consulta",
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>

    <% if consultation.persisted? %>
      <div class="sm:col-span-2">
        <%= f.label :diagnosis, "Diagnóstico", class: "block text-sm font-semibold text-ps-slate-700" %>
        <%= f.text_area :diagnosis, rows: 3,
              class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
      </div>
    <% end %>

    <div class="sm:col-span-2">
      <%= f.label :notes, "Notas", class: "block text-sm font-semibold text-ps-slate-700" %>
      <%= f.text_area :notes, rows: 3, placeholder: "Observações",
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>
  </div>

  <div class="flex gap-2">
    <%= f.submit (consultation.persisted? ? "Salvar" : "Agendar consulta"),
          class: "ps-btn-primary cursor-pointer rounded-lg px-4 py-2.5 text-sm font-semibold" %>
    <%= link_to "Cancelar", (consultation.persisted? ? consultation_path(consultation) : consultations_path),
          class: "rounded-lg border border-ps-border px-4 py-2.5 text-sm font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
  </div>
<% end %>
