<% content_for :title, "Consulta · PrescSign" %>

<!-- Header -->
<section class="rounded-2xl border border-ps-border bg-gradient-to-br from-white to-[#f6faff] p-6 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-[#4a6b93]">Consulta</p>
      <h1 class="mt-1 text-2xl font-bold tracking-tight text-ps-slate-900 sm:text-3xl"><%= @consultation.patient.full_name %></h1>
      <p class="mt-1 flex items-center gap-2 text-sm text-ps-slate-500">
        <%= @consultation.scheduled_at&.strftime("%d/%m/%Y %H:%M") %>
        <%= consultation_status_pill(@consultation.status) %>
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Voltar", consultations_path(patient_id: @consultation.patient_id), class: "rounded-lg border border-ps-border px-4 py-2 text-sm font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
      <% if @consultation.scheduled_status? %>
        <%= link_to "Editar", edit_consultation_path(@consultation), class: "ps-btn-primary rounded-lg px-4 py-2 text-sm font-semibold" %>
        <%= button_to "Cancelar consulta", cancel_consultation_path(@consultation), method: :patch,
              class: "cursor-pointer rounded-lg border border-ps-error-border px-4 py-2 text-sm font-medium text-ps-error-fg hover:bg-ps-error-bg" %>
      <% end %>
    </div>
  </div>
</section>

<!-- Details -->
<section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
  <h2 class="text-lg font-bold text-ps-slate-900">Dados da Consulta</h2>
  <dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% [
         ["Paciente", @consultation.patient.full_name],
         ["Especialidade", @consultation.specialty&.name || "—"],
         ["Profissional", @consultation.user&.email || "—"],
         ["Agendada para", @consultation.scheduled_at&.strftime("%d/%m/%Y %H:%M")],
         ["Finalizada em", @consultation.finished_at&.strftime("%d/%m/%Y %H:%M") || "—"],
         ["Status", consultation_status_label(@consultation.status)]
       ].each do |label, value| %>
      <div class="rounded-xl border border-ps-border bg-[#f9fbff] p-4">
        <dt class="text-sm text-ps-slate-500"><%= label %></dt>
        <dd class="mt-1 font-semibold text-ps-slate-900"><%= value %></dd>
      </div>
    <% end %>
  </dl>

  <div class="mt-4 grid gap-4 sm:grid-cols-1">
    <% [
         ["Queixa principal", @consultation.chief_complaint],
         ["Diagnóstico", @consultation.diagnosis],
         ["Notas", @consultation.notes]
       ].each do |label, value| %>
      <div class="rounded-xl border border-ps-border bg-[#f9fbff] p-4">
        <dt class="text-sm text-ps-slate-500"><%= label %></dt>
        <dd class="mt-1 whitespace-pre-line text-ps-slate-900"><%= value.presence || "—" %></dd>
      </div>
    <% end %>
  </div>
</section>
