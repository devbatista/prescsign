<% content_for :title, "Nova consulta · PrescSign" %>

<section class="rounded-2xl border border-ps-border bg-gradient-to-br from-white to-[#f6faff] p-6 shadow-sm">
  <p class="text-xs font-bold uppercase tracking-wider text-[#4a6b93]">Consultas</p>
  <h1 class="mt-1 text-2xl font-bold tracking-tight text-ps-slate-900 sm:text-3xl">Nova consulta</h1>
  <p class="mt-1 text-sm text-ps-slate-500">Agende um atendimento para um paciente do tenant ativo.</p>
</section>

<section class="mt-6 rounded-2xl border border-ps-border bg-white p-6 shadow-sm">
  <%= render "form",
        consultation: @consultation,
        patients: @patients,
        specialties: @specialties,
        doctors: @organization_doctors %>
</section>
