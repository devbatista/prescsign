<%# Formulário compartilhado (new/edit). Espera @substance e `url`/`method`. %>
<%= form_with model: @substance, url: url, method: method, class: "space-y-6" do |f| %>
  <% if @substance.errors.any? %>
    <div class="rounded-lg border border-[color-mix(in_srgb,var(--admin-down)_45%,transparent)] bg-[color-mix(in_srgb,var(--admin-down)_12%,transparent)] px-3 py-2 text-sm text-[var(--admin-down)]">
      <%= @substance.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <h2 class="admin-group-label">Identificação</h2>
    <div class="mt-3 grid gap-5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= f.label :name, "Nome da substância (DCB)", class: "admin-muted block text-sm font-medium" %>
        <%= f.text_field :name, required: true, placeholder: "Ex.: clonazepam", class: "admin-input mt-2 w-full" %>
      </div>
    </div>
  </div>

  <div>
    <h2 class="admin-group-label">Classificação de controle</h2>
    <div class="mt-3 grid gap-5 sm:grid-cols-2">
      <div>
        <%= f.label :list_344, "Lista (Portaria 344/98)", class: "admin-muted block text-sm font-medium" %>
        <%= f.text_field :list_344, placeholder: "Ex.: B1, A3, C1…", class: "admin-input mt-2 w-full" %>
        <p class="admin-muted mt-1 text-xs">Referência/auditoria. Não decide o fluxo — quem decide é o tipo SNCR abaixo.</p>
      </div>
      <div>
        <%= f.label :sncr_type, "Tipo SNCR", class: "admin-muted block text-sm font-medium" %>
        <%= f.select :sncr_type,
              Prescription::SNCR_TYPE_LABELS.map { |type, label| ["#{type} — #{label}", type] },
              { include_blank: "Não controlada (receita comum)", selected: @substance.sncr_type },
              class: "admin-input mt-2 w-full" %>
        <p class="admin-muted mt-1 text-xs">Campo acionável: define o receituário exigido quando esta substância é prescrita.</p>
      </div>
    </div>
  </div>

  <label class="flex items-center gap-2 text-sm">
    <%= f.check_box :active %>
    <span class="admin-muted">Ativa</span>
  </label>

  <div class="flex items-center gap-3">
    <%= f.submit (@substance.persisted? ? "Salvar alterações" : "Cadastrar substância"), class: "admin-btn admin-btn-primary" %>
    <%= link_to "Cancelar", (@substance.persisted? ? admin_substance_path(@substance) : admin_substances_path), class: "admin-btn admin-btn-ghost" %>
  </div>
<% end %>
