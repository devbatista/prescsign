<% content_for :title, "Back-office · PrescSign" %>

<div class="flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="admin-heading text-2xl font-bold tracking-tight">Back-office</h1>
    <p class="admin-muted mt-1 text-sm">Gestão da plataforma PrescSign (cross-organização).</p>
  </div>
  <span class="admin-muted text-sm"><%= Date.current.strftime("%d/%m/%Y") %></span>
</div>

<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <% [
       ["Organizações", @organizations_count, "building", admin_organizations_path],
       ["Organizações ativas", @active_organizations_count, "building", admin_organizations_path(status: "active")],
       ["Usuários", @users_count, "users", admin_users_path],
       ["Convites pendentes", @pending_invitations_count, "mail", admin_invitations_path(status: "pending")]
     ].each do |label, value, icon, path| %>
    <% card = capture do %>
      <div class="flex items-start justify-between">
        <div>
          <div class="admin-muted text-sm"><%= label %></div>
          <div class="admin-heading mt-2 text-3xl font-bold"><%= value %></div>
        </div>
        <span class="admin-inset flex h-10 w-10 items-center justify-center text-[var(--admin-accent)]"><%= admin_icon icon %></span>
      </div>
    <% end %>
    <% if path %>
      <%= link_to card, path, class: "admin-card block p-5 transition hover:border-[var(--admin-accent)]" %>
    <% else %>
      <div class="admin-card p-5"><%= card %></div>
    <% end %>
  <% end %>
</div>

<div class="admin-card mt-6 p-6">
  <h2 class="admin-heading text-lg font-bold">Módulos</h2>
  <div class="mt-3 flex flex-wrap gap-2">
    <%= link_to admin_organizations_path, class: "admin-btn admin-btn-ghost" do %>
      <%= admin_icon "building", css: "h-4 w-4" %><span>Organizações</span>
    <% end %>
    <%= link_to admin_users_path, class: "admin-btn admin-btn-ghost" do %>
      <%= admin_icon "users", css: "h-4 w-4" %><span>Usuários</span>
    <% end %>
    <%= link_to admin_invitations_path, class: "admin-btn admin-btn-ghost" do %>
      <%= admin_icon "mail", css: "h-4 w-4" %><span>Convites</span>
    <% end %>
  </div>
  <p class="admin-muted mt-3 text-sm">Auditoria global chega em seguida.</p>
</div>
