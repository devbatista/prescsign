<% content_for :title, "Medicamentos · Back-office" %>

<div class="admin-card p-6">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="admin-heading text-2xl font-bold tracking-tight">Medicamentos</h1>
      <p class="admin-muted mt-1 text-sm">Catálogo global da plataforma (<%= @total %> no total).</p>
    </div>
    <% if current_user.admin? %>
      <%= link_to new_admin_medication_path, class: "admin-btn admin-btn-primary" do %>
        <%= admin_icon "pill", css: "h-4 w-4" %><span>Novo medicamento</span>
      <% end %>
    <% end %>
  </div>

  <%= form_with url: admin_medications_path, method: :get, class: "mt-4 flex flex-wrap items-end gap-3" do %>
    <div class="grow">
      <label class="admin-muted block text-sm font-medium">Buscar</label>
      <%= text_field_tag :q, @query, placeholder: "Nome, princípio ativo ou EAN", class: "admin-input mt-1 w-full" %>
    </div>
    <div>
      <label class="admin-muted block text-sm font-medium">Tarja</label>
      <%= select_tag :control_class,
            options_for_select([["Todas", ""]] + AdminHelper::CONTROL_CLASS_LABELS.map { |value, label| [label, value] }, @control_class),
            class: "admin-input mt-1" %>
    </div>
    <div>
      <label class="admin-muted block text-sm font-medium">Status</label>
      <%= select_tag :status,
            options_for_select([["Todos", ""], ["Ativos", "active"], ["Inativos", "inactive"]], @status),
            class: "admin-input mt-1" %>
    </div>
    <%= submit_tag "Filtrar", class: "admin-btn admin-btn-primary" %>
    <% if @query.present? || @status.present? || @control_class.present? %>
      <%= link_to "Limpar", admin_medications_path, class: "admin-btn admin-btn-ghost" %>
    <% end %>
  <% end %>
</div>

<div class="admin-card mt-6 p-6">
  <% if @medications.any? %>
    <div class="overflow-x-auto">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Medicamento</th>
            <th>Princípio ativo</th>
            <th>Forma</th>
            <th>Tarja</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @medications.each do |medication| %>
            <tr>
              <td class="admin-heading font-medium">
                <%= medication.name %>
                <% if medication.strength.present? %>
                  <div class="admin-muted text-xs font-normal"><%= medication.strength %></div>
                <% end %>
              </td>
              <td class="admin-muted"><%= medication.active_ingredient.presence || "—" %></td>
              <td class="admin-muted"><%= admin_medication_form_label(medication.pharmaceutical_form) %></td>
              <td><%= admin_medication_control_pill(medication.control_class) %></td>
              <td><%= admin_medication_status_pill(medication.active) %></td>
              <td class="text-right">
                <%= link_to "Ver", admin_medication_path(medication), class: "admin-btn admin-btn-ghost !py-1.5" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="admin-muted mt-4">
      <%= render "shared/pagination", page: @page, total_pages: @total_pages, total: @total %>
    </div>
  <% else %>
    <p class="admin-muted text-sm">Nenhum medicamento encontrado com os filtros atuais.</p>
  <% end %>
</div>
