<% content_for :title, "Organizações · Back-office" %>

<div class="admin-card p-6">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="admin-heading text-2xl font-bold tracking-tight">Organizações</h1>
      <p class="admin-muted mt-1 text-sm">Todas as organizações da plataforma (<%= @total %> no total).</p>
    </div>
    <% if current_user.admin? %>
      <%= link_to new_admin_organization_path, class: "admin-btn admin-btn-primary" do %>
        <%= admin_icon "building", css: "h-4 w-4" %><span>Nova organização</span>
      <% end %>
    <% end %>
  </div>

  <%= form_with url: admin_organizations_path, method: :get, class: "mt-4 flex flex-wrap items-end gap-3" do %>
    <div class="grow">
      <label class="admin-muted block text-sm font-medium">Buscar</label>
      <%= text_field_tag :q, @query, placeholder: "Nome, razão social ou CNPJ", class: "admin-input mt-1 w-full" %>
    </div>
    <div>
      <label class="admin-muted block text-sm font-medium">Status</label>
      <%= select_tag :status,
            options_for_select([["Todos", ""], ["Ativas", "active"], ["Inativas", "inactive"]], @status),
            class: "admin-input mt-1" %>
    </div>
    <%= submit_tag "Filtrar", class: "admin-btn admin-btn-primary" %>
    <% if @query.present? || @status.present? %>
      <%= link_to "Limpar", admin_organizations_path, class: "admin-btn admin-btn-ghost" %>
    <% end %>
  <% end %>
</div>

<div class="admin-card mt-6 p-6">
  <% if @organizations.any? %>
    <div class="overflow-x-auto">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Organização</th>
            <th>Tipo</th>
            <th>CNPJ</th>
            <th>Status</th>
            <th>Criada em</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @organizations.each do |organization| %>
            <tr>
              <td class="admin-heading font-medium">
                <%= organization.name %>
                <% if organization.legal_name.present? %>
                  <div class="admin-muted text-xs font-normal"><%= organization.legal_name %></div>
                <% end %>
              </td>
              <td class="admin-muted"><%= admin_organization_kind_label(organization.kind) %></td>
              <td class="admin-muted font-mono text-xs"><%= organization.cnpj.presence || "—" %></td>
              <td><%= admin_organization_status_pill(organization.active) %></td>
              <td class="admin-muted"><%= organization.created_at.strftime("%d/%m/%Y") %></td>
              <td class="text-right">
                <%= link_to "Ver", admin_organization_path(organization), class: "admin-btn admin-btn-ghost !py-1.5" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="admin-muted mt-4">
      <%= render "shared/pagination", page: @page, total_pages: @total_pages, total: @total %>
    </div>
  <% else %>
    <p class="admin-muted text-sm">Nenhuma organização encontrada com os filtros atuais.</p>
  <% end %>
</div>
