<header class="border-b border-ps-border bg-white">
  <div class="px-6">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 py-3">
      <%= link_to app_root_path, class: "flex shrink-0 items-center" do %>
        <img src="/prescsign-logo.svg" alt="PrescSign" class="h-9 w-auto" />
      <% end %>

      <nav class="flex flex-wrap items-center gap-1" aria-label="Navegação principal">
        <% nav_items.each do |item| %>
          <% active = item.path != "#" && current_page?(item.path) %>
          <%= link_to item.label, item.path,
                class: "rounded-full px-4 py-1.5 text-sm font-semibold #{active ? "bg-ps-info-bg text-ps-blue-700" : "text-ps-slate-700 hover:bg-[#f4f7fc]"}" %>
        <% end %>
      </nav>

      <div class="ml-auto flex flex-wrap items-center gap-3">
        <% if available_organizations.many? %>
          <div class="flex items-center gap-2">
            <span class="hidden text-sm text-ps-slate-500 lg:inline">Organização</span>
            <%= form_with url: switch_organization_path, method: :post do %>
              <%= select_tag :organization_id,
                    options_for_select(available_organizations.map { |o| [o.name, o.id] }, current_organization&.id),
                    onchange: "this.form.requestSubmit()",
                    class: "rounded-lg border border-ps-border bg-white px-3 py-1.5 text-sm text-ps-slate-900 outline-none focus:border-ps-blue-500" %>
            <% end %>
          </div>
        <% elsif current_organization %>
          <span class="hidden items-center gap-2 text-sm sm:flex">
            <span class="text-ps-slate-500">Organização</span>
            <span class="rounded-lg border border-ps-border px-3 py-1.5 font-medium text-ps-slate-700"><%= current_organization.name %></span>
          </span>
        <% end %>

        <span class="hidden rounded-lg bg-[#eef4ff] px-3 py-1.5 text-sm font-medium text-ps-blue-700 sm:inline"><%= current_user.email %></span>

        <%= button_to "Sair", destroy_user_session_path, method: :delete,
              class: "cursor-pointer rounded-lg border border-ps-border px-4 py-1.5 text-sm font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
      </div>
    </div>
  </div>
</header>
