<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <title>Receita médica</title>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        color: #1b1b1b;
        font-family: "Helvetica Neue", Arial, sans-serif;
        font-size: 12px;
        line-height: 1.5;
      }
      .page {
        padding: 28px 32px;
      }
      .header {
        border-bottom: 2px solid #1f4b99;
        margin-bottom: 20px;
        padding-bottom: 12px;
      }
      .title {
        color: #1f4b99;
        font-size: 22px;
        font-weight: 700;
        margin: 0;
      }
      .subtitle {
        color: #5b6373;
        font-size: 11px;
        margin: 3px 0 0;
      }
      .sncr-banner {
        border: 1.5px solid #8d95a6;
        border-radius: 6px;
        margin-bottom: 18px;
        padding: 10px 14px;
        width: 100%;
      }
      /* Cores históricas das notificações (Portaria 344/98). */
      .sncr-banner--blue {
        background: #f4f7fd;
        border-color: #1f4b99;
      }
      .sncr-banner--blue .sncr-kind,
      .sncr-banner--blue .sncr-number {
        color: #1f4b99;
      }
      .sncr-banner--yellow {
        background: #fdf7e3;
        border-color: #b8860b;
      }
      .sncr-banner--yellow .sncr-kind,
      .sncr-banner--yellow .sncr-number {
        color: #8a6d00;
      }
      .sncr-banner--neutral {
        background: #ffffff;
        border-color: #8d95a6;
      }
      .sncr-banner--neutral .sncr-kind,
      .sncr-banner--neutral .sncr-number {
        color: #333a45;
      }
      .sncr-cell {
        display: inline-block;
        vertical-align: top;
        width: 60%;
      }
      .sncr-cell--number {
        text-align: right;
        width: 39%;
      }
      .sncr-eyebrow {
        color: #5b6373;
        display: block;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .sncr-kind {
        font-size: 13px;
      }
      .sncr-number {
        font-family: "Courier New", Courier, monospace;
        font-size: 16px;
      }
      .grid {
        width: 100%;
      }
      .col {
        display: inline-block;
        vertical-align: top;
        width: 49%;
      }
      .section {
        border: 1px solid #d9deea;
        border-radius: 6px;
        margin-bottom: 14px;
        padding: 12px;
      }
      .section-title {
        color: #1f4b99;
        font-size: 12px;
        font-weight: 700;
        margin: 0 0 8px;
      }
      .line {
        margin: 0 0 4px;
      }
      .mono {
        font-family: "Courier New", Courier, monospace;
        font-size: 11px;
        word-break: break-all;
      }
      .label {
        color: #5b6373;
        font-weight: 600;
      }
      .validation-grid {
        width: 100%;
      }
      .validation-details {
        display: inline-block;
        vertical-align: top;
        width: 70%;
      }
      .validation-qr {
        display: inline-block;
        vertical-align: top;
        text-align: right;
        width: 28%;
      }
      .validation-qr svg {
        height: 110px;
        width: 110px;
      }
      .content {
        border: 1px solid #d9deea;
        border-radius: 6px;
        margin-bottom: 22px;
        min-height: 200px;
        padding: 16px;
        white-space: pre-wrap;
      }
      /* Lista de itens estruturados. `pre-wrap` e altura mínima existem para a
         receita em texto livre — na lista eles viram buraco branco e quebram o
         alinhamento do número do item com o nome do medicamento. */
      .content--items {
        min-height: 0;
        padding: 12px 16px 12px 34px;
        white-space: normal;
      }
      .item {
        border-top: 1px solid #e6eaf2;
        margin-top: 10px;
        padding-top: 10px;
      }
      .item:first-child {
        border-top: 0;
        margin-top: 0;
        padding-top: 0;
      }
      .item-name {
        font-size: 13px;
        font-weight: 700;
        margin: 0 0 3px;
      }
      .item-sncr {
        color: #8a6d00;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.04em;
        margin: 0 0 3px;
        text-transform: uppercase;
      }
      .signature {
        border-top: 1px solid #8d95a6;
        margin-top: 40px;
        padding-top: 8px;
        text-align: center;
      }
      .signature strong {
        display: block;
      }
      .signature span {
        color: #5b6373;
        font-size: 11px;
      }
      .footer {
        border-top: 1px solid #d9deea;
        color: #5b6373;
        font-size: 10px;
        margin-top: 20px;
        padding-top: 8px;
      }
    </style>
  </head>
  <body>
    <main class="page">
      <%= yield %>
    </main>
  </body>
</html>
