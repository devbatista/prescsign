<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title).presence || "PrescSign" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-[#f4f7fc] text-ps-slate-900 antialiased">
    <% if user_signed_in? %>
      <header class="border-b border-ps-border bg-white">
        <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
          <%= link_to root_path, class: "flex items-center" do %>
            <img src="/prescsign-logo.svg" alt="PrescSign" class="h-8 w-auto" />
          <% end %>
          <div class="flex items-center gap-4 text-sm">
            <span class="text-ps-slate-500"><%= current_user.email %></span>
            <%= button_to "Sair", destroy_user_session_path, method: :delete,
                  class: "cursor-pointer rounded-lg border border-ps-border px-3 py-1.5 font-medium text-ps-slate-700 hover:bg-[#f4f7fc]" %>
          </div>
        </div>
      </header>
    <% end %>

    <% if notice.present? %>
      <div class="border-b border-ps-success-border bg-ps-success-bg px-4 py-3 text-sm text-ps-success-fg">
        <div class="mx-auto max-w-5xl"><%= notice %></div>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="border-b border-ps-error-border bg-ps-error-bg px-4 py-3 text-sm text-ps-error-fg">
        <div class="mx-auto max-w-5xl"><%= alert %></div>
      </div>
    <% end %>

    <main class="mx-auto max-w-5xl px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>
