<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title).presence || "PrescSign" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased">
    <% if notice.present? %>
      <div class="bg-green-50 border-b border-green-200 px-4 py-3 text-sm text-green-800"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="bg-red-50 border-b border-red-200 px-4 py-3 text-sm text-red-800"><%= alert %></div>
    <% end %>

    <main class="mx-auto max-w-5xl px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>
