<% content_for :title, "Validar documento · PrescSign" %>

<section class="mx-auto max-w-xl rounded-2xl border border-ps-border bg-white p-8 shadow-sm">
  <h1 class="text-2xl font-bold tracking-tight text-ps-slate-900">Validar documento</h1>
  <p class="mt-1 text-sm text-ps-slate-500">Informe o código de verificação impresso no documento.</p>

  <%= form_with url: public_document_validation_search_path, method: :get, class: "mt-6 space-y-4" do %>
    <div>
      <label for="code" class="block text-sm font-semibold text-ps-slate-700">Código do documento</label>
      <%= text_field_tag :code, params[:code], required: true, placeholder: "Ex.: ABCD123456",
            class: "mt-2 block w-full rounded-lg border border-ps-border px-3 py-2 text-sm uppercase outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
    </div>
    <%= submit_tag "Validar", class: "ps-btn-primary w-full cursor-pointer rounded-lg px-4 py-2.5 text-sm font-semibold" %>
  <% end %>
</section>
