<% content_for :title, "Redefinir senha · PrescSign" %>
<% content_for :auth_title, "Redefinir senha" %>
<% content_for :auth_subtitle, "Escolha uma nova senha para sua conta." %>

<%= form_with url: user_password_update_path, method: :put, scope: :user, class: "space-y-5" do |f| %>
  <%= f.hidden_field :reset_password_token, value: @token %>

  <div>
    <%= f.label :password, "Nova senha", class: "block text-sm font-semibold text-ps-slate-700" %>
    <%= f.password_field :password, autocomplete: "new-password", minlength: 8, required: true,
          class: "mt-2 block w-full rounded-xl border border-ps-border bg-white px-4 py-3 text-sm text-ps-slate-900 shadow-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
  </div>

  <div>
    <%= f.label :password_confirmation, "Confirmar nova senha", class: "block text-sm font-semibold text-ps-slate-700" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", minlength: 8, required: true,
          class: "mt-2 block w-full rounded-xl border border-ps-border bg-white px-4 py-3 text-sm text-ps-slate-900 shadow-sm outline-none focus:border-ps-blue-500 focus:ring-4 focus:ring-ps-blue-500/15" %>
  </div>

  <%= f.submit "Redefinir senha",
        class: "ps-btn-primary w-full cursor-pointer rounded-xl px-4 py-3 text-sm font-semibold" %>
<% end %>
