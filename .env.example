# -----------------------------------------------------------------------------
# PrescSign API - Environment Template
# Copy to `.env` in local development and adjust values.
# -----------------------------------------------------------------------------

# Core
RAILS_ENV=development
RAILS_LOG_LEVEL=debug
RAILS_MAX_THREADS=5
RAILS_SERVE_STATIC_FILES=

# App URL (used by mailer default_url_options)
APP_HOST=app.prescsign.local
APP_PORT=3000
APP_PROTOCOL=http
# Base registrable domain for host-auth + session cookie sharing across the
# login./register./app./admin. subdomains. Defaults to the last two labels of
# APP_HOST; override for multi-part TLDs (e.g. example.co.uk).
# Required for multi-part TLDs such as .com.br; otherwise Rails may treat
# login.prescsign.com.br as subdomain login.prescsign and redirect to login.com.br.
# APP_DOMAIN=prescsign.com.br
WEB_PORT_HOST=3000
NGINX_PORT_HOST=8080
POSTGRES_PORT_HOST=5432
REDIS_PORT_HOST=6379
WAIT_FOR_DEPENDENCIES=true
WAIT_FOR_SERVICES_TIMEOUT=60
WAIT_FOR_SERVICES_SLEEP=2

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB_DEVELOPMENT=prescsign_development
POSTGRES_DB_TEST=prescsign_test
POSTGRES_DB_PRODUCTION=prescsign_production

# In production prefer DATABASE_URL
# Example: postgres://user:password@db:5432/prescsign_production
# DATABASE_URL=

# Redis — compartilhado por Sidekiq, ActionCable, Rack::Attack e, desde a
# integração SNCR, pelo armazenamento do access_token (Sncr::TokenStore).
# ATENÇÃO no Docker/Compose: o host é o NOME DO SERVIÇO `redis`, NÃO localhost.
# Deixar `localhost` aqui faz o container tentar 127.0.0.1:6379 e dar
# "Connection refused". Só use localhost ao rodar o app direto no host (sem Docker).
REDIS_URL=redis://redis:6379/1

# Queue / Jobs
# development: async (default)
# production: sidekiq (recommended)
ACTIVE_JOB_QUEUE_ADAPTER=async
SIDEKIQ_CONCURRENCY=5

# Storage
# development/test usually local/test
# production usually s3 (AWS S3 or R2 via endpoint)
ACTIVE_STORAGE_SERVICE=local
DOCUMENTS_PDF_SIGNED_URL_EXPIRES_IN=900

# Retention policy (days)
# Tune these values based on legal/compliance requirements in your deployment.
# Documents are permanent by default.
RETENTION_DOCUMENT_VERSIONS_DAYS=permanent
RETENTION_AUDIT_LOGS_DAYS=2190
RETENTION_DELIVERY_LOGS_DAYS=1825
RETENTION_TMP_FILES_DAYS=7
RETENTION_UNATTACHED_BLOBS_DAYS=2

# Mailer behavior
RAISE_MAIL_DELIVERY_ERRORS=false

# Session / cookies
# Devise uses SECRET_KEY_BASE for token generation. Required in production.
SECRET_KEY_BASE=change-me-in-production
# Cookie domain shared across subdomains (login./app./admin.). Leave blank to
# derive from the request host.
# SESSION_COOKIE_DOMAIN=.prescsign.local

# -----------------------------------------------------------------------------
# Integration placeholders (planned in MVP scope)
# -----------------------------------------------------------------------------

# Authentication
AUTH_USERS_REQUIRED=false
AUTH_USERS_FALLBACK_PROVISIONING=true
USERS_MIGRATION_PHASE=phase2_users_auth_enabled
USERS_MIGRATION_ALLOW_DOCTOR_FALLBACK=true
OBS_ROLLOUT_PHASE=users_migration

# Object storage (S3 / R2)
# If S3_BUCKET is set, related S3_* credentials should also be set.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
# Some S3-compatible providers may require path-style URLs.
S3_FORCE_PATH_STYLE=false

# SendGrid
# SENDGRID_FROM_EMAIL becomes required when SENDGRID_API_KEY is configured.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Twilio
# TWILIO_AUTH_TOKEN and TWILIO_FROM_NUMBER become required when TWILIO_ACCOUNT_SID is configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Cloud API
# WHATSAPP_PHONE_NUMBER_ID becomes required when WHATSAPP_ACCESS_TOKEN is configured.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# Digital signature provider
# SIGNATURE_PROVIDER supports: internal, icp_brasil, eval_crypto_cubo.
SIGNATURE_PROVIDER=internal

# Caminho do binário wkhtmltopdf (renderização do PDF via WickedPdf).
# Default do initializer: /usr/bin/wkhtmltopdf. No container é esse mesmo; no host
# aponte para o binário local (ex.: o do gem wkhtmltopdf-binary).
WKHTMLTOPDF_PATH=

# EVALCryptoCubo — endpoint APIM v0: sign/qualified/pdf?profile=&icpbr=
EVAL_CRYPTO_CUBO_BASE_URL=
# API_KEY = Ocp-Apim-Subscription-Key
EVAL_CRYPTO_CUBO_API_KEY=
EVAL_CRYPTO_CUBO_OPERATOR_ID=
EVAL_CRYPTO_CUBO_TYPE=qualified
EVAL_CRYPTO_CUBO_FORMAT=detached
# profile seleciona a política server-side; icpbr indica assinatura ICP-Brasil.
EVAL_CRYPTO_CUBO_PROFILE=
EVAL_CRYPTO_CUBO_ICPBR=false
EVAL_CRYPTO_CUBO_ALIAS=
# true = usa o ALIAS acima (certificado fixo de local/homologação), ignorando o
# CPF do médico logado. Em produção deixe false (assina com o CPF do médico).
EVAL_CRYPTO_CUBO_USE_CONFIG_ALIAS=false
# PIN em texto puro; o provider codifica em Base64 ao enviar.
EVAL_CRYPTO_CUBO_PIN=
EVAL_CRYPTO_CUBO_TIMEOUT_SECONDS=30

# SNCR (Anvisa) — receitas de controlados
# Quando SNCR_ENABLED=true, as variáveis obrigatórias são exigidas em produção.
SNCR_ENABLED=false
SNCR_BASE_URL=https://sncr-api.apps.anvisa.gov.br/api/v1
SNCR_TIMEOUT_SECONDS=30
# client_url para onde o SNCR devolve o navegador após o login Gov.br. A Anvisa
# valida esse valor de forma ingênua e só aceita a ORIGEM (domínio puro `.br`,
# sem path) — enviar um path retorna 403 "Domínio não autorizado". Ela cola
# `?session_id=...` no fim, e o app captura na raiz do `app.` (ver docs/sncr 4.2.1).
# Prod: https://app.<seu-dominio>.br  | Dev: não alcança a Anvisa (host .local).
SNCR_AUTH_CALLBACK_URL=https://app.prescsign.com.br
SNCR_PLATFORM_CNPJ=
# Obs.: o dance OIDC com o Gov.br é conduzido pelo servidor do SNCR (ele é o
# cliente OIDC registrado no Keycloak da Anvisa). O PrescSign apenas redireciona
# para /auth/login e troca o session_id — não usa client-secret de Keycloak.

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
